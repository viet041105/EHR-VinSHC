  "events": [
    {
      "event": "registration_committed",
      "effect": "Create first queue waiting item",
      "automatic": true
    },
    {
      "event": "vitals_finalized",
      "effect": "Complete nurse queue and create doctor waiting item",
      "automatic": true
    },
    {
      "event": "order_created",
      "effect": "Create lab waiting item after assignment/payment gates",
      "automatic": true
    },
    {
      "event": "result_finalized",
      "effect": "Notify assigned doctor worklist; do not close consultation/visit",
      "automatic": true
    },
    {
      "event": "consultation_finalized",
      "effect": "User confirms next step to lab/cashier; outstanding order remains",
      "automatic": false
    },
    {
      "event": "visit_cancel_or_left",
      "effect": "User confirms reason; retain records/payments; stop new execution",
      "automatic": false
    },
    {
      "event": "payment_settled",
      "effect": "Release matching prepay service gate only; never mark clinical result final",
      "automatic": true
    }
  ],
  "concurrency": "Idempotent event key + unique queue item per visit/servicepoint/iteration; transaction locks; explicit re-queue is new iteration",
