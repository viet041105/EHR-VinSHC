{
  "name": "vinshc-frontend",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "shell",
    "modules/*"
  ],
  "scripts": {
    "dev": "node dev.mjs --host 127.0.0.1 --port 5173 --strictPort",
    "build": "node scripts/build.mjs",
    "build:package": "node scripts/build.mjs --only",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test tests/unit/*.test.mjs",
    "test:browser": "node tests/browser/landing-check.cjs && node tests/browser/connected-check.cjs && node tests/browser/additional-check.cjs && node tests/browser/workspace-check.cjs && node tests/browser/microfrontend-check.cjs && node tests/browser/product-check.cjs && node tests/browser/doctor-assistant-check.cjs && node tests/browser/demo-workflow-check.cjs && node tests/browser/role-workspaces-check.cjs",
    "test:connected": "node tests/browser/connected-check.cjs",
    "test:live": "node tests/browser/live-check.cjs",
    "test:api": "node scripts/check-api-coverage.mjs",
    "backend:prepare": "node docker-local.mjs prepare",
    "backend:build": "node docker-local.mjs build",
    "backend:up": "node docker-local.mjs up",
    "backend:status": "node docker-local.mjs status",
    "backend:down": "node docker-local.mjs down",
    "backend:metadata": "python3 scripts/configure-metadata.py",
    "backend:admin": "python3 scripts/configure-admin.py",
    "test:agent-browser": "node tests/browser/agent-check.cjs && node tests/browser/agent-workspace-check.cjs",
    "test:demo": "node tests/browser/demo-workflow-check.cjs",
    "test:pages": "node tests/browser/pages-check.cjs && node tests/browser/administration-check.cjs && node tests/browser/portal-pages-check.cjs",
    "test:roles": "node tests/browser/role-workspaces-check.cjs",
    "test:patient-access": "node tests/browser/patient-access-check.cjs"
  },
  "devDependencies": {
    "playwright": "1.64.0",
    "vite": "8.3.4"
  },
  "type": "module"
}
