<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd">
  <bean id="vinshcService" class="org.openmrs.module.vinshc.service.VinshcService">
    <constructor-arg ref="sessionFactory"/>
  </bean>
  <bean id="vinshcAuthorizationService" class="org.openmrs.module.vinshc.service.AuthorizationService">
    <constructor-arg ref="sessionFactory"/>
  </bean>
  <bean id="vinshcClinicalService" class="org.openmrs.module.vinshc.service.ClinicalService">
    <constructor-arg ref="sessionFactory"/>
  </bean>
  <bean id="vinshcOperationsService" class="org.openmrs.module.vinshc.service.OperationsService">
    <constructor-arg ref="sessionFactory"/>
  </bean>
</beans>
