<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd">
  <bean id="vinshcService" class="org.openmrs.module.vinshc.service.VinshcService">
    <constructor-arg ref="sessionFactory"/>
  </bean>
  <bean id="vinshcAuthorizationService" class="org.openmrs.module.vinshc.service.AuthorizationService">
    <constructor-arg ref="sessionFactory"/>
  </bean>
  <bean id="vinshcStaffAccountService" class="org.openmrs.module.vinshc.service.StaffAccountService"><constructor-arg ref="sessionFactory"/></bean>
  <bean id="vinshcDirectoryService" class="org.openmrs.module.vinshc.service.DirectoryService"><constructor-arg ref="sessionFactory"/></bean>
  <bean id="vinshcFormWorkflowService" class="org.openmrs.module.vinshc.service.FormWorkflowService"><constructor-arg ref="sessionFactory"/></bean>
  <bean id="vinshcClinicalService" class="org.openmrs.module.vinshc.service.ClinicalService">
    <constructor-arg ref="sessionFactory"/>
    <constructor-arg ref="vinshcService"/>
  </bean>
  <bean id="vinshcCareService" class="org.openmrs.module.vinshc.service.CareService">
    <constructor-arg ref="sessionFactory"/>
    <constructor-arg ref="vinshcService"/>
  </bean>
  <bean id="vinshcPharmacyService" class="org.openmrs.module.vinshc.service.PharmacyService">
    <constructor-arg ref="sessionFactory"/>
  </bean>
  <bean id="vinshcOperationsService" class="org.openmrs.module.vinshc.service.OperationsService">
    <constructor-arg ref="sessionFactory"/>
    <constructor-arg ref="vinshcNotificationService"/>
  </bean>
  <bean id="vinshcPortalService" class="org.openmrs.module.vinshc.service.PortalService"><constructor-arg ref="sessionFactory"/><constructor-arg ref="vinshcClinicalService"/><constructor-arg ref="vinshcAuthorizationService"/></bean>
  <bean id="vinshcNotificationService" class="org.openmrs.module.vinshc.service.NotificationService"><constructor-arg ref="sessionFactory"/><constructor-arg ref="vinshcAuthorizationService"/><constructor-arg ref="vinshcPortalService"/></bean>
  <bean id="vinshcPatientAccessService" class="org.openmrs.module.vinshc.service.PatientAccessService"><constructor-arg ref="sessionFactory"/><constructor-arg ref="vinshcAuthorizationService"/><constructor-arg ref="vinshcPortalService"/><constructor-arg ref="vinshcNotificationService"/></bean>
</beans>
