<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">
  <changeSet id="vinshc-0.2.0-extension-storage" author="vinshc" dbms="postgresql">
    <createTable tableName="vinshc_contact">
      <column name="contact_id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
      <column name="row_key" type="VARCHAR(38)"><constraints nullable="false"/></column>
      <column name="version_number" type="INT"><constraints nullable="false"/></column>
      <column name="patient_id" type="INT"><constraints nullable="false" references="patient(patient_id)" foreignKeyName="fk_vinshc_contact_patient"/></column>
      <column name="full_name" type="VARCHAR(255)"/>
      <column name="relationship_code" type="VARCHAR(64)"/>
      <column name="relationship_name" type="VARCHAR(255)"/>
      <column name="relationship_version" type="VARCHAR(64)"/>
      <column name="phone_raw" type="VARCHAR(64)"/>
      <column name="phone_normalized" type="VARCHAR(32)"/>
      <column name="phone_normalization_status" type="VARCHAR(32)"/>
      <column name="address_text" type="VARCHAR(2000)"/>
      <column name="priority" type="INT"/>
      <column name="is_primary" type="BOOLEAN"><constraints nullable="false"/></column>
      <column name="emergency_contact" type="BOOLEAN"><constraints nullable="false"/></column>
      <column name="linked_person_id" type="INT"/>
      <column name="source_kind" type="VARCHAR(32)"/><column name="source_document_uuid" type="VARCHAR(38)"/>
      <column name="source_page" type="VARCHAR(64)"/><column name="source_reference" type="VARCHAR(255)"/>
      <column name="recorded_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
      <column name="status" type="VARCHAR(16)"><constraints nullable="false"/></column>
      <column name="void_reason" type="VARCHAR(1000)"/>
      <column name="is_current" type="BOOLEAN"><constraints nullable="false"/></column>
      <column name="creator" type="INT"><constraints nullable="false" references="users(user_id)" foreignKeyName="fk_vinshc_contact_creator"/></column>
      <column name="date_created" type="TIMESTAMP"><constraints nullable="false"/></column>
    </createTable>
    <sql>CREATE UNIQUE INDEX ux_vinshc_contact_current ON vinshc_contact(row_key) WHERE is_current</sql>
    <sql>CREATE UNIQUE INDEX ux_vinshc_contact_primary ON vinshc_contact(patient_id) WHERE is_current AND status='active' AND is_primary</sql>
    <sql>CREATE UNIQUE INDEX ux_vinshc_contact_priority ON vinshc_contact(patient_id, priority) WHERE is_current AND status='active'</sql>
    <createIndex tableName="vinshc_contact" indexName="ix_vinshc_contact_patient"><column name="patient_id"/><column name="is_current"/></createIndex>

    <createTable tableName="vinshc_field_state">
      <column name="field_state_id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
      <column name="version_number" type="INT"><constraints nullable="false"/></column>
      <column name="patient_id" type="INT"><constraints nullable="false" references="patient(patient_id)" foreignKeyName="fk_vinshc_state_patient"/></column>
      <column name="field_code" type="VARCHAR(128)"><constraints nullable="false"/></column>
      <column name="row_key" type="VARCHAR(38)"/>
      <column name="context" type="VARCHAR(16)"><constraints nullable="false"/></column>
      <column name="data_status" type="VARCHAR(32)"><constraints nullable="false"/></column>
      <column name="source_kind" type="VARCHAR(32)"/><column name="source_reference" type="VARCHAR(255)"/>
      <column name="recorded_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
      <column name="is_current" type="BOOLEAN"><constraints nullable="false"/></column>
      <column name="creator" type="INT"><constraints nullable="false" references="users(user_id)" foreignKeyName="fk_vinshc_state_creator"/></column>
      <column name="date_created" type="TIMESTAMP"><constraints nullable="false"/></column>
    </createTable>
    <sql>CREATE UNIQUE INDEX ux_vinshc_state_current ON vinshc_field_state(patient_id, field_code, context, COALESCE(row_key, '')) WHERE is_current</sql>
    <createIndex tableName="vinshc_field_state" indexName="ix_vinshc_state_patient"><column name="patient_id"/><column name="is_current"/></createIndex>

    <createTable tableName="vinshc_address_snapshot">
      <column name="address_id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
      <column name="row_key" type="VARCHAR(38)"><constraints nullable="false"/></column>
      <column name="version_number" type="INT"><constraints nullable="false"/></column>
      <column name="patient_id" type="INT"><constraints nullable="false" references="patient(patient_id)" foreignKeyName="fk_vinshc_address_patient"/></column>
      <column name="address_text" type="VARCHAR(2000)"/>
      <column name="legacy_address_text" type="VARCHAR(2000)"/>
      <column name="province_code" type="VARCHAR(2)"/><column name="province_name" type="VARCHAR(255)"/>
      <column name="commune_code" type="VARCHAR(5)"/><column name="commune_name" type="VARCHAR(255)"/>
      <column name="catalogue_version" type="VARCHAR(64)"/><column name="address_as_of_date" type="DATE"/>
      <column name="source_kind" type="VARCHAR(32)"/><column name="source_reference" type="VARCHAR(255)"/>
      <column name="recorded_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
      <column name="status" type="VARCHAR(16)"><constraints nullable="false"/></column>
      <column name="void_reason" type="VARCHAR(1000)"/><column name="is_current" type="BOOLEAN"><constraints nullable="false"/></column>
      <column name="creator" type="INT"><constraints nullable="false" references="users(user_id)" foreignKeyName="fk_vinshc_address_creator"/></column>
      <column name="date_created" type="TIMESTAMP"><constraints nullable="false"/></column>
    </createTable>
    <sql>CREATE UNIQUE INDEX ux_vinshc_address_current ON vinshc_address_snapshot(row_key) WHERE is_current</sql>
    <createIndex tableName="vinshc_address_snapshot" indexName="ix_vinshc_address_patient"><column name="patient_id"/><column name="is_current"/></createIndex>
    <!-- Raw <sql> has no automatic rollback; dropping the tables also drops their partial indexes.
         Rollback blocks are not part of the changeset checksum. -->
    <rollback>
      <dropTable tableName="vinshc_address_snapshot"/>
      <dropTable tableName="vinshc_field_state"/>
      <dropTable tableName="vinshc_contact"/>
    </rollback>
  </changeSet>
  <changeSet id="vinshc-0.2.1-complete-source-provenance" author="vinshc" dbms="postgresql">
    <addColumn tableName="vinshc_contact">
      <column name="source_row_code" type="VARCHAR(255)"/>
    </addColumn>
    <addColumn tableName="vinshc_field_state">
      <column name="source_document_uuid" type="VARCHAR(38)"/>
      <column name="source_page" type="VARCHAR(64)"/>
      <column name="source_row_code" type="VARCHAR(255)"/>
    </addColumn>
    <addColumn tableName="vinshc_address_snapshot">
      <column name="source_document_uuid" type="VARCHAR(38)"/>
      <column name="source_page" type="VARCHAR(64)"/>
      <column name="source_row_code" type="VARCHAR(255)"/>
    </addColumn>
  </changeSet>
  <changeSet id="vinshc-0.3.0-clinical-events" author="vinshc" dbms="postgresql">
    <comment>Append-only audit of B4 clinical writes; also records consultation finalization.</comment>
    <createTable tableName="vinshc_clinical_event">
      <column name="event_id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
      <column name="event_uuid" type="VARCHAR(38)"><constraints nullable="false" unique="true" uniqueConstraintName="ux_vinshc_clinical_event_uuid"/></column>
      <column name="event_type" type="VARCHAR(64)"><constraints nullable="false"/></column>
      <column name="patient_id" type="INT"><constraints nullable="false" references="patient(patient_id)" foreignKeyName="fk_vinshc_event_patient"/></column>
      <column name="encounter_id" type="INT"><constraints references="encounter(encounter_id)" foreignKeyName="fk_vinshc_event_encounter"/></column>
      <column name="entity_uuid" type="VARCHAR(38)"/>
      <column name="reason" type="VARCHAR(1000)"/>
      <column name="detail" type="VARCHAR(2000)"/>
      <column name="creator" type="INT"><constraints nullable="false" references="users(user_id)" foreignKeyName="fk_vinshc_event_creator"/></column>
      <column name="date_created" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
    </createTable>
    <sql>CREATE UNIQUE INDEX ux_vinshc_consultation_finalized ON vinshc_clinical_event(encounter_id) WHERE event_type='consultation_finalized'</sql>
    <createIndex tableName="vinshc_clinical_event" indexName="ix_vinshc_event_encounter"><column name="encounter_id"/></createIndex>
    <createIndex tableName="vinshc_clinical_event" indexName="ix_vinshc_event_patient"><column name="patient_id"/></createIndex>
    <rollback>
      <dropTable tableName="vinshc_clinical_event"/>
    </rollback>
  </changeSet>
  <changeSet id="vinshc-0.3.0-workspace-authorization" author="vinshc" dbms="postgresql">
    <createTable tableName="vinshc_workspace_assignment">
      <column name="assignment_id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
      <column name="assignment_uuid" type="VARCHAR(38)"><constraints nullable="false" unique="true" uniqueConstraintName="ux_vinshc_workspace_assignment_uuid"/></column>
      <column name="user_id" type="INT"><constraints nullable="false" references="users(user_id)" foreignKeyName="fk_vinshc_workspace_user"/></column>
      <column name="role_name" type="VARCHAR(32)"><constraints nullable="false"/></column>
      <column name="facility_location_id" type="INT"><constraints nullable="false" references="location(location_id)" foreignKeyName="fk_vinshc_workspace_location"/></column>
      <column name="active" type="BOOLEAN"><constraints nullable="false"/></column>
      <column name="creator" type="INT"><constraints nullable="false" references="users(user_id)" foreignKeyName="fk_vinshc_workspace_creator"/></column>
      <column name="date_created" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
    </createTable>
    <sql>CREATE UNIQUE INDEX ux_vinshc_workspace_active ON vinshc_workspace_assignment(user_id, role_name, facility_location_id) WHERE active</sql>
    <createTable tableName="vinshc_access_event">
      <column name="event_id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
      <column name="event_uuid" type="VARCHAR(38)"><constraints nullable="false" unique="true" uniqueConstraintName="ux_vinshc_access_event_uuid"/></column>
      <column name="resource_type" type="VARCHAR(64)"><constraints nullable="false"/></column>
      <column name="patient_id" type="INT"><constraints references="patient(patient_id)" foreignKeyName="fk_vinshc_access_patient"/></column>
      <column name="encounter_id" type="INT"><constraints references="encounter(encounter_id)" foreignKeyName="fk_vinshc_access_encounter"/></column>
      <column name="entity_uuid" type="VARCHAR(38)"/>
      <column name="action" type="VARCHAR(16)"><constraints nullable="false"/></column>
      <column name="detail" type="VARCHAR(1000)"/>
      <column name="creator" type="INT"><constraints nullable="false" references="users(user_id)" foreignKeyName="fk_vinshc_access_creator"/></column>
      <column name="date_created" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
    </createTable>
    <createIndex tableName="vinshc_access_event" indexName="ix_vinshc_access_patient"><column name="patient_id"/><column name="date_created"/></createIndex>
    <createIndex tableName="vinshc_access_event" indexName="ix_vinshc_access_encounter"><column name="encounter_id"/><column name="date_created"/></createIndex>
    <rollback>
      <dropTable tableName="vinshc_access_event"/>
      <dropTable tableName="vinshc_workspace_assignment"/>
    </rollback>
  </changeSet>
  <changeSet id="vinshc-0.3.0-clinic-operations" author="vinshc" dbms="postgresql">
    <comment>B8 transactional clinic operations owned by the VinSHC adapter.</comment>
    <createTable tableName="vinshc_appointment">
      <column name="appointment_id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
      <column name="appointment_uuid" type="VARCHAR(38)"><constraints nullable="false" unique="true" uniqueConstraintName="ux_vinshc_appointment_uuid"/></column>
      <column name="patient_id" type="INT"><constraints nullable="false" references="patient(patient_id)" foreignKeyName="fk_vinshc_appointment_patient"/></column>
      <column name="visit_id" type="INT"><constraints references="visit(visit_id)" foreignKeyName="fk_vinshc_appointment_visit"/></column>
      <column name="facility_location_id" type="INT"><constraints nullable="false" references="location(location_id)" foreignKeyName="fk_vinshc_appointment_location"/></column>
      <column name="provider_id" type="INT"><constraints references="provider(provider_id)" foreignKeyName="fk_vinshc_appointment_provider"/></column>
      <column name="service_uuid" type="VARCHAR(38)"><constraints nullable="false"/></column>
      <column name="appointment_type" type="VARCHAR(32)"><constraints nullable="false"/></column>
      <column name="start_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
      <column name="end_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
      <column name="status" type="VARCHAR(32)"><constraints nullable="false"/></column>
      <column name="note" type="VARCHAR(1000)"/>
      <column name="idempotency_key" type="VARCHAR(128)"><constraints nullable="false" unique="true" uniqueConstraintName="ux_vinshc_appointment_key"/></column>
      <column name="creator" type="INT"><constraints nullable="false" references="users(user_id)" foreignKeyName="fk_vinshc_appointment_creator"/></column>
      <column name="date_created" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
      <column name="changed_by" type="INT"/><column name="date_changed" type="TIMESTAMP WITH TIME ZONE"/>
    </createTable>
    <createIndex tableName="vinshc_appointment" indexName="ix_vinshc_appointment_slot"><column name="facility_location_id"/><column name="provider_id"/><column name="start_at"/><column name="end_at"/></createIndex>

    <createTable tableName="vinshc_queue_item">
      <column name="queue_item_id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
      <column name="queue_item_uuid" type="VARCHAR(38)"><constraints nullable="false" unique="true" uniqueConstraintName="ux_vinshc_queue_uuid"/></column>
      <column name="patient_id" type="INT"><constraints nullable="false" references="patient(patient_id)" foreignKeyName="fk_vinshc_queue_patient"/></column>
      <column name="visit_id" type="INT"><constraints nullable="false" references="visit(visit_id)" foreignKeyName="fk_vinshc_queue_visit"/></column>
      <column name="facility_location_id" type="INT"><constraints nullable="false" references="location(location_id)" foreignKeyName="fk_vinshc_queue_location"/></column>
      <column name="provider_id" type="INT"><constraints references="provider(provider_id)" foreignKeyName="fk_vinshc_queue_provider"/></column>
      <column name="config_code" type="VARCHAR(32)"><constraints nullable="false"/></column>
      <column name="point_code" type="VARCHAR(32)"><constraints nullable="false"/></column>
      <column name="iteration" type="INT"><constraints nullable="false"/></column>
      <column name="queue_number" type="INT"><constraints nullable="false"/></column>
      <column name="state" type="VARCHAR(32)"><constraints nullable="false"/></column>
      <column name="exit_reason" type="VARCHAR(64)"/>
      <column name="idempotency_key" type="VARCHAR(128)"><constraints nullable="false" unique="true" uniqueConstraintName="ux_vinshc_queue_key"/></column>
      <column name="creator" type="INT"><constraints nullable="false" references="users(user_id)" foreignKeyName="fk_vinshc_queue_creator"/></column>
      <column name="date_created" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
      <column name="changed_by" type="INT"/><column name="date_changed" type="TIMESTAMP WITH TIME ZONE"/>
    </createTable>
    <addUniqueConstraint tableName="vinshc_queue_item" columnNames="visit_id,point_code,iteration" constraintName="ux_vinshc_queue_iteration"/>
    <createIndex tableName="vinshc_queue_item" indexName="ix_vinshc_queue_order"><column name="facility_location_id"/><column name="point_code"/><column name="date_created"/><column name="queue_number"/></createIndex>

    <createTable tableName="vinshc_bill">
      <column name="bill_id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
      <column name="bill_uuid" type="VARCHAR(38)"><constraints nullable="false" unique="true" uniqueConstraintName="ux_vinshc_bill_uuid"/></column>
      <column name="patient_id" type="INT"><constraints nullable="false" references="patient(patient_id)" foreignKeyName="fk_vinshc_bill_patient"/></column>
      <column name="visit_id" type="INT"><constraints nullable="false" references="visit(visit_id)" foreignKeyName="fk_vinshc_bill_visit"/></column>
      <column name="facility_uuid" type="VARCHAR(38)"><constraints nullable="false"/></column>
      <column name="currency" type="VARCHAR(3)"><constraints nullable="false"/></column>
      <column name="payment_timing" type="VARCHAR(16)"><constraints nullable="false"/></column>
      <column name="lines_json" type="TEXT"><constraints nullable="false"/></column>
      <column name="total_vnd" type="BIGINT"><constraints nullable="false"/></column>
      <column name="status" type="VARCHAR(32)"><constraints nullable="false"/></column>
      <column name="cancel_reason" type="VARCHAR(1000)"/>
      <column name="idempotency_key" type="VARCHAR(128)"><constraints nullable="false" unique="true" uniqueConstraintName="ux_vinshc_bill_key"/></column>
      <column name="creator" type="INT"><constraints nullable="false" references="users(user_id)" foreignKeyName="fk_vinshc_bill_creator"/></column>
      <column name="date_created" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
      <column name="changed_by" type="INT"/><column name="date_changed" type="TIMESTAMP WITH TIME ZONE"/>
    </createTable>
    <createTable tableName="vinshc_payment">
      <column name="payment_id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
      <column name="payment_uuid" type="VARCHAR(38)"><constraints nullable="false" unique="true" uniqueConstraintName="ux_vinshc_payment_uuid"/></column>
      <column name="bill_id" type="BIGINT"><constraints nullable="false" references="vinshc_bill(bill_id)" foreignKeyName="fk_vinshc_payment_bill"/></column>
      <column name="kind" type="VARCHAR(16)"><constraints nullable="false"/></column>
      <column name="original_payment_id" type="BIGINT"><constraints references="vinshc_payment(payment_id)" foreignKeyName="fk_vinshc_payment_original"/></column>
      <column name="amount_vnd" type="BIGINT"><constraints nullable="false"/></column>
      <column name="method" type="VARCHAR(32)"><constraints nullable="false"/></column>
      <column name="status" type="VARCHAR(16)"><constraints nullable="false"/></column>
      <column name="reason" type="VARCHAR(1000)"/>
      <column name="idempotency_key" type="VARCHAR(128)"><constraints nullable="false" unique="true" uniqueConstraintName="ux_vinshc_payment_key"/></column>
      <column name="creator" type="INT"><constraints nullable="false" references="users(user_id)" foreignKeyName="fk_vinshc_payment_creator"/></column>
      <column name="date_created" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
      <column name="settled_by" type="INT"/><column name="settled_at" type="TIMESTAMP WITH TIME ZONE"/>
    </createTable>

    <createTable tableName="vinshc_service_order">
      <column name="service_order_id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
      <column name="order_id" type="INT"><constraints nullable="false" references="orders(order_id)" foreignKeyName="fk_vinshc_service_order_native"/></column>
      <column name="patient_id" type="INT"><constraints nullable="false" references="patient(patient_id)" foreignKeyName="fk_vinshc_service_order_patient"/></column>
      <column name="encounter_id" type="INT"><constraints nullable="false" references="encounter(encounter_id)" foreignKeyName="fk_vinshc_service_order_encounter"/></column>
      <column name="visit_id" type="INT"><constraints nullable="false" references="visit(visit_id)" foreignKeyName="fk_vinshc_service_order_visit"/></column>
      <column name="facility_uuid" type="VARCHAR(38)"><constraints nullable="false"/></column>
      <column name="service_uuid" type="VARCHAR(38)"><constraints nullable="false"/></column>
      <column name="service_code" type="VARCHAR(64)"><constraints nullable="false"/></column>
      <column name="service_name" type="VARCHAR(255)"><constraints nullable="false"/></column>
      <column name="state" type="VARCHAR(32)"><constraints nullable="false"/></column>
      <column name="assigned_provider_id" type="INT"><constraints references="provider(provider_id)" foreignKeyName="fk_vinshc_service_order_assignee"/></column>
      <column name="bill_id" type="BIGINT"><constraints references="vinshc_bill(bill_id)" foreignKeyName="fk_vinshc_service_order_bill"/></column>
      <column name="idempotency_key" type="VARCHAR(128)"><constraints nullable="false" unique="true" uniqueConstraintName="ux_vinshc_service_order_key"/></column>
      <column name="creator" type="INT"><constraints nullable="false" references="users(user_id)" foreignKeyName="fk_vinshc_service_order_creator"/></column>
      <column name="date_created" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
      <column name="changed_by" type="INT"/><column name="date_changed" type="TIMESTAMP WITH TIME ZONE"/>
    </createTable>
    <addUniqueConstraint tableName="vinshc_service_order" columnNames="order_id" constraintName="ux_vinshc_service_order_native"/>
    <createTable tableName="vinshc_result_revision">
      <column name="result_id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
      <column name="result_uuid" type="VARCHAR(38)"><constraints nullable="false" unique="true" uniqueConstraintName="ux_vinshc_result_uuid"/></column>
      <column name="service_order_id" type="BIGINT"><constraints nullable="false" references="vinshc_service_order(service_order_id)" foreignKeyName="fk_vinshc_result_order"/></column>
      <column name="version_number" type="INT"><constraints nullable="false"/></column>
      <column name="state" type="VARCHAR(32)"><constraints nullable="false"/></column>
      <column name="numeric_value" type="NUMERIC(30,10)"/>
      <column name="text_value" type="TEXT"/>
      <column name="unit" type="VARCHAR(64)"/>
      <column name="previous_result_id" type="BIGINT"><constraints references="vinshc_result_revision(result_id)" foreignKeyName="fk_vinshc_result_previous"/></column>
      <column name="correction_reason" type="VARCHAR(1000)"/>
      <column name="author_provider_id" type="INT"><constraints nullable="false" references="provider(provider_id)" foreignKeyName="fk_vinshc_result_author"/></column>
      <column name="reviewer_provider_id" type="INT"><constraints references="provider(provider_id)" foreignKeyName="fk_vinshc_result_reviewer"/></column>
      <column name="recorded_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
      <column name="reviewed_at" type="TIMESTAMP WITH TIME ZONE"/>
      <column name="creator" type="INT"><constraints nullable="false" references="users(user_id)" foreignKeyName="fk_vinshc_result_creator"/></column>
      <column name="date_created" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
    </createTable>
    <addUniqueConstraint tableName="vinshc_result_revision" columnNames="service_order_id,version_number" constraintName="ux_vinshc_result_version"/>
    <createTable tableName="vinshc_attachment">
      <column name="attachment_id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
      <column name="attachment_uuid" type="VARCHAR(38)"><constraints nullable="false" unique="true" uniqueConstraintName="ux_vinshc_attachment_uuid"/></column>
      <column name="service_order_id" type="BIGINT"><constraints nullable="false" references="vinshc_service_order(service_order_id)" foreignKeyName="fk_vinshc_attachment_order"/></column>
      <column name="result_id" type="BIGINT"><constraints references="vinshc_result_revision(result_id)" foreignKeyName="fk_vinshc_attachment_result"/></column>
      <column name="storage_key" type="VARCHAR(255)"><constraints nullable="false" unique="true" uniqueConstraintName="ux_vinshc_attachment_key"/></column>
      <column name="original_name" type="VARCHAR(255)"><constraints nullable="false"/></column>
