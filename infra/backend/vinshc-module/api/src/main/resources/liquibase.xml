    <createTable tableName="vinshc_document">
      <column name="document_id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
      <column name="document_uuid" type="VARCHAR(38)"><constraints nullable="false" unique="true" uniqueConstraintName="ux_vinshc_document_uuid"/></column>
