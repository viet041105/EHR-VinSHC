  <changeSet id="vinshc-0.3.1-timestamptz" author="vinshc" dbms="postgresql">
    <comment>Align the B2 date_created columns with the other TIMESTAMPTZ audit columns. Existing values are JVM wall
      time; the pinned backend image runs in UTC (/etc/localtime -> UTC, TZ unset), so they are interpreted as UTC.</comment>
    <sql>ALTER TABLE vinshc_contact ALTER COLUMN date_created TYPE TIMESTAMP WITH TIME ZONE USING date_created AT TIME ZONE 'UTC'</sql>
    <sql>ALTER TABLE vinshc_field_state ALTER COLUMN date_created TYPE TIMESTAMP WITH TIME ZONE USING date_created AT TIME ZONE 'UTC'</sql>
    <sql>ALTER TABLE vinshc_address_snapshot ALTER COLUMN date_created TYPE TIMESTAMP WITH TIME ZONE USING date_created AT TIME ZONE 'UTC'</sql>
    <rollback>
      <sql>ALTER TABLE vinshc_contact ALTER COLUMN date_created TYPE TIMESTAMP USING date_created AT TIME ZONE 'UTC'</sql>
      <sql>ALTER TABLE vinshc_field_state ALTER COLUMN date_created TYPE TIMESTAMP USING date_created AT TIME ZONE 'UTC'</sql>
      <sql>ALTER TABLE vinshc_address_snapshot ALTER COLUMN date_created TYPE TIMESTAMP USING date_created AT TIME ZONE 'UTC'</sql>
    </rollback>
  </changeSet>
