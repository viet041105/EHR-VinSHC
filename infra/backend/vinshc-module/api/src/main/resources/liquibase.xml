  <changeSet id="vinshc-0.4.1-patient-portal" author="vinshc" dbms="postgresql">
    <sql>
      CREATE TABLE vinshc_portal_account (user_id INT PRIMARY KEY REFERENCES users(user_id), patient_id INT NOT NULL REFERENCES patient(patient_id), active BOOLEAN NOT NULL DEFAULT true, creator INT NOT NULL REFERENCES users(user_id), date_created TIMESTAMP WITH TIME ZONE NOT NULL);
      CREATE TABLE vinshc_portal_publication (publication_id BIGSERIAL PRIMARY KEY, publication_uuid VARCHAR(38) NOT NULL UNIQUE, patient_id INT NOT NULL REFERENCES patient(patient_id), visit_id INT NOT NULL REFERENCES visit(visit_id), encounter_id INT NOT NULL REFERENCES encounter(encounter_id), version INT NOT NULL, source_revision BIGINT NOT NULL, payload_json TEXT NOT NULL, active BOOLEAN NOT NULL DEFAULT true, creator INT NOT NULL REFERENCES users(user_id), date_created TIMESTAMP WITH TIME ZONE NOT NULL, UNIQUE(visit_id,version));
      CREATE UNIQUE INDEX ux_vinshc_portal_active_visit ON vinshc_portal_publication(visit_id) WHERE active=true;
      CREATE INDEX ix_vinshc_portal_patient ON vinshc_portal_publication(patient_id,active);
      CREATE INDEX ix_vinshc_portal_account_patient ON vinshc_portal_account(patient_id);
    </sql>
    <rollback><sql>DROP TABLE vinshc_portal_publication; DROP TABLE vinshc_portal_account;</sql></rollback>
  </changeSet>
  <changeSet id="vinshc-0.4.2-single-user-workspace" author="vinshc" dbms="postgresql">
    <comment>Keep only the newest active role/facility workspace per staff account.</comment>
    <sql>
      WITH ranked AS (
        SELECT assignment_id, ROW_NUMBER() OVER (
          PARTITION BY user_id ORDER BY date_created DESC, assignment_id DESC
        ) AS position
        FROM vinshc_workspace_assignment
        WHERE active=true
      )
      UPDATE vinshc_workspace_assignment a
      SET active=false
      FROM ranked r
      WHERE a.assignment_id=r.assignment_id AND r.position&gt;1;
    </sql>
    <sql>CREATE UNIQUE INDEX ux_vinshc_workspace_one_per_user ON vinshc_workspace_assignment(user_id) WHERE active=true</sql>
    <rollback><sql>DROP INDEX ux_vinshc_workspace_one_per_user;</sql></rollback>
  </changeSet>
