  <changeSet id="vinshc-0.3.1-timestamptz" author="vinshc" dbms="postgresql">
    <comment>Align the B2 date_created columns with the other TIMESTAMPTZ audit columns. Existing values are JVM wall
      time; the pinned backend image runs in UTC (/etc/localtime -> UTC, TZ unset), so they are interpreted as UTC.</comment>
    <sql>ALTER TABLE vinshc_contact ALTER COLUMN date_created TYPE TIMESTAMP WITH TIME ZONE USING date_created AT TIME ZONE 'UTC'</sql>
    <sql>ALTER TABLE vinshc_field_state ALTER COLUMN date_created TYPE TIMESTAMP WITH TIME ZONE USING date_created AT TIME ZONE 'UTC'</sql>
    <sql>ALTER TABLE vinshc_address_snapshot ALTER COLUMN date_created TYPE TIMESTAMP WITH TIME ZONE USING date_created AT TIME ZONE 'UTC'</sql>
    <rollback>
      <sql>ALTER TABLE vinshc_contact ALTER COLUMN date_created TYPE TIMESTAMP USING date_created AT TIME ZONE 'UTC'</sql>
      <sql>ALTER TABLE vinshc_field_state ALTER COLUMN date_created TYPE TIMESTAMP USING date_created AT TIME ZONE 'UTC'</sql>
      <sql>ALTER TABLE vinshc_address_snapshot ALTER COLUMN date_created TYPE TIMESTAMP USING date_created AT TIME ZONE 'UTC'</sql>
    </rollback>
  </changeSet>
  <changeSet id="vinshc-0.4.0-patient-registration" author="vinshc" dbms="postgresql">
    <comment>Facility where a patient was registered through the staff adapter; brings the patient into that facility's
      scope before a first visit. The idempotency key lets a retried registration return the same patient.</comment>
    <createTable tableName="vinshc_patient_registration">
      <column name="registration_id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
      <column name="registration_uuid" type="VARCHAR(38)"><constraints nullable="false" unique="true" uniqueConstraintName="ux_vinshc_registration_uuid"/></column>
      <column name="patient_id" type="INT"><constraints nullable="false" references="patient(patient_id)" foreignKeyName="fk_vinshc_registration_patient"/></column>
      <column name="facility_location_id" type="INT"><constraints nullable="false" references="location(location_id)" foreignKeyName="fk_vinshc_registration_location"/></column>
      <column name="idempotency_key" type="VARCHAR(128)"><constraints nullable="false" unique="true" uniqueConstraintName="ux_vinshc_registration_key"/></column>
      <column name="creator" type="INT"><constraints nullable="false" references="users(user_id)" foreignKeyName="fk_vinshc_registration_creator"/></column>
      <column name="date_created" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
    </createTable>
    <addUniqueConstraint tableName="vinshc_patient_registration" columnNames="patient_id,facility_location_id" constraintName="ux_vinshc_registration_patient_facility"/>
    <createIndex tableName="vinshc_patient_registration" indexName="ix_vinshc_registration_facility"><column name="facility_location_id"/><column name="date_created"/></createIndex>
  </changeSet>
  <changeSet id="vinshc-0.4.0-dispensing" author="vinshc" dbms="postgresql">
    <comment>Append-only pharmacy dispense records against native DrugOrders. Batch/expiry are captured as dispensed;
      stock levels stay out of scope until Stock Management is accepted for the pilot.</comment>
    <createTable tableName="vinshc_dispense">
      <column name="dispense_id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
