      <column name="order_id" type="INT"><constraints nullable="false" references="orders(order_id)" foreignKeyName="fk_vinshc_dispense_order"/></column>
      <column name="patient_id" type="INT"><constraints nullable="false" references="patient(patient_id)" foreignKeyName="fk_vinshc_dispense_patient"/></column>
      <column name="visit_id" type="INT"><constraints references="visit(visit_id)" foreignKeyName="fk_vinshc_dispense_visit"/></column>
      <column name="facility_location_id" type="INT"><constraints nullable="false" references="location(location_id)" foreignKeyName="fk_vinshc_dispense_location"/></column>
      <column name="quantity" type="NUMERIC(19,4)"><constraints nullable="false"/></column>
      <column name="batch_number" type="VARCHAR(64)"/>
      <column name="expiry_date" type="DATE"/>
      <column name="note" type="VARCHAR(1000)"/>
      <column name="status" type="VARCHAR(16)"><constraints nullable="false"/></column>
      <column name="void_reason" type="VARCHAR(1000)"/>
      <column name="idempotency_key" type="VARCHAR(128)"><constraints nullable="false" unique="true" uniqueConstraintName="ux_vinshc_dispense_key"/></column>
      <column name="creator" type="INT"><constraints nullable="false" references="users(user_id)" foreignKeyName="fk_vinshc_dispense_creator"/></column>
      <column name="date_created" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
      <column name="changed_by" type="INT"><constraints references="users(user_id)" foreignKeyName="fk_vinshc_dispense_changed_by"/></column>
      <column name="date_changed" type="TIMESTAMP WITH TIME ZONE"/>
    </createTable>
    <createIndex tableName="vinshc_dispense" indexName="ix_vinshc_dispense_order"><column name="order_id"/><column name="status"/></createIndex>
    <createIndex tableName="vinshc_dispense" indexName="ix_vinshc_dispense_facility"><column name="facility_location_id"/><column name="date_created"/></createIndex>
  </changeSet>
