# Copy to infra/agent/.env and enter your key locally; do not commit .env.
# Free tier: synthetic patient records/questions only.
VINSHC_AGENT_MODEL_PROVIDER=gemini
VINSHC_AGENT_ALLOW_EXTERNAL_MODEL=true
