# Sao chép thành infra/agent/.env khi chạy local; src/main.py tự nạp file này. Không commit file .env.

# Địa chỉ lắng nghe khi chạy bằng src/main.py (Docker dùng uvicorn với 0.0.0.0:8000).
VINSHC_AGENT_HOST=127.0.0.1
VINSHC_AGENT_PORT=8000

# Gốc REST của OpenMRS (agent tự thêm vinshc/...). Ngoài máy local phải dùng HTTPS (BE-11).
VINSHC_AGENT_BACKEND_URL=http://127.0.0.1:8080/openmrs/ws/rest/v1
VINSHC_AGENT_BACKEND_TIMEOUT=15

# fake: model tất định. anthropic: Claude. gemini: Gemini Developer API.
VINSHC_AGENT_MODEL_PROVIDER=fake
# Bắt buộc true khi dùng model bên ngoài. Chỉ bật với dữ liệu synthetic hoặc khi đánh giá tác động
# xử lý dữ liệu cá nhân đã được duyệt (docs/VIETNAM_COMPLIANCE.md).
VINSHC_AGENT_ALLOW_EXTERNAL_MODEL=false
VINSHC_AGENT_ANTHROPIC_MODEL=claude-opus-5-5
VINSHC_AGENT_ANTHROPIC_EFFORT=high
VINSHC_AGENT_GEMINI_MODEL=gemini-3.8-flash
VINSHC_AGENT_GEMINI_THINKING_LEVEL=low
GEMINI_API_KEY=
# VINSHC_AGENT_GEMINI_API_KEY_FILE=/run/secrets/gemini_api_key
VINSHC_AGENT_MODEL_TIMEOUT=45
VINSHC_AGENT_REQUEST_TIMEOUT=90
VINSHC_AGENT_MODEL_MAX_TOKENS=4096
VINSHC_AGENT_MODEL_MAX_RETRIES=2

# Credential để gọi Claude (chỉ cần khi MODEL_PROVIDER=anthropic). Chọn MỘT cách:
#  1) Dán khóa vào infra/agent/.env (file này đã nằm trong .gitignore, không commit):
ANTHROPIC_API_KEY=
#  2) Trỏ tới file chứa khóa (Docker secret / secret manager); ưu tiên hơn ANTHROPIC_API_KEY:
# VINSHC_AGENT_ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key
#  3) Dùng profile sau khi chạy `ant auth login`:
# ANTHROPIC_PROFILE=default
# Kiểm tra: python src/main.py --check-model

# Luồng bệnh nhân: disabled (mặc định, trả 503) fixture (synthetic), hoặc http (cổng bệnh nhân trên BE).
VINSHC_AGENT_PATIENT_PORTAL=disabled
# VINSHC_AGENT_PATIENT_FIXTURE=infra/agent/fixtures/patient_portal.demo.json
# Hiển thị trong câu trả lời cho bệnh nhân khi cần liên hệ phòng khám.
# VINSHC_AGENT_CLINIC_CONTACT=Hotline phòng khám: ...

# Giới hạn chống lạm dụng và vòng lặp tool.
VINSHC_AGENT_RATE_LIMIT_PER_MINUTE=20
VINSHC_AGENT_MAX_TOOL_ROUNDS=4
VINSHC_AGENT_MAX_TOOL_CALLS_PER_ROUND=4
