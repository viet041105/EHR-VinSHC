# Run: python scripts/bootstrap.py
# It creates .env and replaces GENERATE_* with random local passwords.
COMPOSE_PROJECT_NAME=ehr-vinshc
EHR_HTTP_PORT=8080
OMRS_DB_USER=openmrs
OMRS_DB_PASSWORD=GENERATE_DB_PASSWORD
EHR_ADMIN_USERNAME=admin
EHR_ADMIN_PASSWORD=GENERATE_ADMIN_PASSWORD
# Baseline uses upstream English; Vietnamese translations are a later task.
SPA_DEFAULT_LOCALE=en
